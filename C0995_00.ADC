[IDENTIFICATION]
ID					12:394			//ID of COM board
CHANNEL				4:0			//Both Channels

[CONFIG]
CFG_INTERVAL		8:14
RESERVED			6:0
INTERVAL			2:3		//3 is default - 160 ms; 0..10 ms, 1..40 ms, 2..80 ms, 3..160 ms

//---------------------------------------   
// Configuração do endereço IP da porta 1
//---------------------------------------
[CONFIG]    
CFG_MY_IP_NW1		8:1		// IP Address Channel1
MY_IP_NW1_B1		8:192				 
MY_IP_NW1_B2		8:168
MY_IP_NW1_B3		8:172	
MY_IP_NW1_B4		8:179

//---------------------------------------   
// Configuração do endereço IP da porta 2
//---------------------------------------
// [CONFIG]
// CFG_MY_IP_NW2		8:2		// IP Address Channel1
// MY_IP_NW2_B1		8:				 
// MY_IP_NW2_B2		8:
// MY_IP_NW2_B3		8:
// MY_IP_NW2_B4		8:
    
//----------------------------------------  
// Definição da máscara de subrede própria
//----------------------------------------
[CONFIG]
CFG_MY_MASK			8:5		 
RESERVED			3:0					 
MY_MASK_NW1			5:28		//Subnet mask for network 1 		 
RESERVED			3:0					 
MY_MASK_NW2			5:0		//Subnet mask for network 2 (enter 0, if not used)		

//---------------------------------
// Default gateway NW1 (Ethernet 1)  
// Configurada uma 1x por rede  
//---------------------------------
[CONFIG]
CFG_DFLT_GTWY_IP    8:18    // Default gateway IP address network 1
DFLT_GTWY_IP_B1		8:192
DFLT_GTWY_IP_B2		8:168
DFLT_GTWY_IP_B3		8:172
DFLT_GTWY_IP_B4		8:177

