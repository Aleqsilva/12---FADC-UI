//---------------------------------------------------------------
// Encaminhamento de dados de contagem de eixo via Ethernet (UDP)
//---------------------------------------------------------------
// IJU-1 - PARA CONTAGEM
[CONFIG]
CFG_FWRD_ACD			8:9		//forwarding axle count-ing data from CAN to UDP
INT_ID_DEST				4:1		//socket 0..15
CAN_TX_ID				12:325		//ID of the AEB whose data should be sent (0 not allowed, 1..4095)

//IQB-1 - PARA CONTAGEM
[CONFIG]
CFG_FWRD_ACD			8:9		//forwarding axle count-ing data from CAN to UDP
INT_ID_DEST				4:2		//socket 0..15
CAN_TX_ID				12:350		//ID of the AEB whose data should be sent (0 not allowed, 1..4095)

//IQB-1 - PARA CONTAGEM
[CONFIG]
CFG_FWRD_ACD			8:9		//forwarding axle count-ing data from CAN to UDP
INT_ID_DEST				4:2		//socket 0..15
CAN_TX_ID				12:340		//ID of the AEB whose data should be sent (0 not allowed, 1..4095)

//IQB-1 - PARA SENSIBILIZAÇÃO
[CONFIG]
CFG_FWRD_ACD			8:9		//forwarding axle count-ing data from CAN to UDP
INT_ID_DEST				4:2		//socket 0..15
CAN_TX_ID				12:345		//ID of the AEB whose data should be sent (0 not allowed, 1..4095)

//---------------------------------------------------------------
// Encaminhamento de dados de diagnóstico
//---------------------------------------------------------------

// FDS IQB1
[CONFIG]
CFG_FWRD_DIAG		8:11		//configuration forwarding diagnostic mes-sages from CAN to UDP
RESERVED			4:0
INT_ID_DEST			4:1			//socket 0..15 (depending on configuration of CFG_INT_ID_DEST_NW1 resp. CFG_INT_ID_DEST_NW2

//--------------------------------------------------
// Número do projeto
//--------------------------------------------------
[CONFIG]
CFG_PROJECT_COM		8:13
RESERVED			3:0
VERSION_VERIFY		1:0				//0 is default - do not check entry “VERIFY“ and “VERSION“
PROJECT_NUMBER		20:1			//0 is default 

